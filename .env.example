# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# AWS SES Email Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
SES_FROM_EMAIL=your-verified-email@yourdomain.com
CONTACT_TO_EMAIL=info@fdpservices.com

# Site URL (for email branding - logo images)
# Set this to your public domain URL (e.g., https://fdpservices.com)
# For local development, you can use ngrok or leave as default (logo may not display)
SITE_URL=https://yourdomain.com

# Production Settings (for deployment)
# FLASK_ENV=production
# FLASK_DEBUG=False
